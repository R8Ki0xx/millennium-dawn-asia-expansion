# MD ROC Return v3.14 —— 南京总统府实体（复制自原版 landmarks.asset；模型与贴图用原版文件）

entity = {
	name = "building_landmark_nanjing_presidential_palace"
	pdxmesh = "landmark_nanjing_presidential_palace_mesh"

	default_state = "idle"
	state = { name = "idle"				animation = "idle"       		animation_blend_time = 0.3 animation_speed = 0.8 looping = yes }

	scale = 0.16

}

entity = {
	name = "building_landmark_nanjing_presidential_palace_destroyed"
	pdxmesh = "landmark_nanjing_presidential_palace_destroyed_mesh"

	default_state = "destroy"
	state = { name = "destroy"			animation = "destroy" 			animation_blend_time = 0.3  animation_speed = 0.8 looping = no
			event = { time = 4.1 node="explosion1" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 5 node="explosion2" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 6.5 node="explosion3" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 7.5 node="explosion4" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 9 node="explosion5" particle = "building_explode_effect" keep_particle = yes }

			event = { time = 15.5 node="impact" particle = "vehicle_explode_effect" keep_particle = yes }

			event = { time = 5.4 node="explosion2" particle = "building_fire_particle" keep_particle = yes }
			event = { time = 13 node="explosion3" particle = "building_fire_particle" keep_particle = yes }
			event = { time = 10 node="explosion5" particle = "building_fire_particle" keep_particle = yes }

			event = { time = 4.2 sound = { soundeffect = "explosion_c4" }}
			event = { time = 5.1 sound = { soundeffect = "explosion_c4" }}
			event = { time = 6.6 sound = { soundeffect = "explosion_c4" }}
			event = { time = 7.6 sound = { soundeffect = "explosion_c4" }}
			event = { time = 10.4 sound = { soundeffect = "explosion_flashbang_large" }}

				}


	scale = 0.16
}

